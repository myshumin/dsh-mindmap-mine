{
  "name": "dsh-mindmap-mine",
  "version": "0.11.0",
  "private": false,
  "license": "MIT",
  "author": "Schumin",
  "description": "DSH 插件（自用魔改版）：工作区级实时思维导图，作为 DSH 右侧栏标签页运行 —— 图落盘到工作区 .dsh/mindmaps/，跨会话共享，可一键导出需求文档；agent 与用户在同一个树上双向编辑，画布基于 mind-elixir。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "mindmap",
    "mind-elixir"
  ],
  "files": [
    "lib",
    "tools",
    "dsh.bundle.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myshumin/dsh-mindmap-mine.git"
  },
  "homepage": "https://github.com/myshumin/dsh-mindmap-mine#readme",
  "bugs": {
    "url": "https://github.com/myshumin/dsh-mindmap-mine/issues"
  }
}
